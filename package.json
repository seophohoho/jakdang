{
  "name": "jakdang",
  "version": "0.1.0",
  "private": true,
  "description": "국내 개발자 행사 공고 알림 봇",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "tsc -p tsconfig.build.json",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "sources:check": "tsx src/cli.ts sources:check",
    "sync": "tsx src/cli.ts sync",
    "notifications:flush": "tsx src/cli.ts notifications:flush",
    "notifications:resolve": "tsx src/cli.ts notifications:resolve",
    "notifications:test": "tsx src/cli.ts notifications:test",
    "api:call": "tsx scripts/call-api.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "pg": "^8.23.1",
    "rss-parser": "^3.13.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
