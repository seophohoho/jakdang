{"sql":"SELECT C.cl_srl, C.cl_type, C.cl_cate, C.mb_id, C.cl_name, C.cl_title, C.cl_host, C.cl_start_date, C.cl_end_date, C.cl_target,\n                C.cl_status, C.cl_dday, C.cl_reg_date, A.ad_srl, C.cl_update,\n\t\t\t\t\t\t\t\t(SELECT SUM(cv_visit) FROM a2_contest_visit WHERE cl_srl = C.cl_srl) AS cl_view\n            FROM a2_ad_list A LEFT JOIN a2_contest_list C\n                ON A.cl_srl = C.cl_srl\n            WHERE C.cl_status > 0 AND C.cl_disp = 1 AND C.cl_type IN (1,3) AND C.cl_reserve_date < '2026-10-26 00:00:12' \/*AND A.ad_status = 2*\/ AND A.ad_code = 'BOT'\n            AND A.ad_st < '2026-10-26 00:00:12' AND A.ad_et > '2026-10-26 00:00:12'  AND (FIND_IN_SET(1, REPLACE(C.cl_target, ' ', '')) > 0 OR FIND_IN_SET(2, REPLACE(C.cl_target, ' ', '')) > 0 OR FIND_IN_SET(3, REPLACE(C.cl_target, ' ', '')) > 0 OR FIND_IN_SET(4, REPLACE(C.cl_target, ' ', '')) > 0 OR FIND_IN_SET(8, REPLACE(C.cl_target, ' ', '')) > 0 OR FIND_IN_SET(9, REPLACE(C.cl_target, ' ', '')) > 0)  AND (FIND_IN_SET(5, REPLACE(C.cl_cate, ' ', '')) > 0)  AND (FIND_IN_SET(31, REPLACE(C.cl_sub_cate, ' ', '')) > 0)  order by A.ad_order asc, A.ad_et desc","currentPage":1,"totalPage":2,"totalCount":16,"perPage":10,"rows":[{"cl_srl":"543905","cl_cate":"<span class=\"badge cl_cate\">\uc544\uc774\ub514\uc5b4\u00b7\ucc3d\uc5c5\u00b7\ub9c8\ucf00\ud305\u00b7\ub124\uc774\ubc0d<\/span><span class=\"badge cl_cate\">\ubb38\ud559\u00b7\ud559\uc220<\/span><span class=\"badge cl_cate\">\uacfc\ud559\u00b7\uacf5\ud559\u00b7\ud559\uc220<\/span><span class=\"badge cl_cate\">\uc77c\ubc18\uc778<\/span><span class=\"badge cl_cate\">\ub300\ud559\uc0dd<\/span><span class=\"badge cl_cate\">\ub300\ud559\uc6d0\uc0dd<\/span>","cl_status":"<span class='badge cl_status2'>\uc811\uc218\uc911<\/span><br>D-14","cl_view":"2003","cl_title":"<a href='\/hit\/contest\/4572?page=1&sortname=cl_order&sortorder=asc&t=1&ct=5&sc=31&tg='>[6G Vision Fest 2026] 6G \uc11c\ube44\uc2a4 \uc2dc\ub098\ub9ac\uc624 \uacf5\ubaa8\uc804<\/a>","cl_date":"